# Copy to .env (make env does this and generates random secrets). Never commit .env.

# --- PostgreSQL (one container, one database + role per service)
POSTGRES_USER=payverse
POSTGRES_PASSWORD=change-me
SERVICE_DB_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Security
JWT_ISSUER=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:3000
# client_credentials secret shared by internal services in local dev (per-service secrets / mTLS in prod)
SERVICE_CLIENT_SECRET=change-me
# comma-separated mobiles that receive ADMIN / SUPPORT roles on login (local seeding, no Keycloak)
ADMIN_MOBILES=9000000001
SUPPORT_MOBILES=9000000002
# OTP SMS: msg91 (real MSG91 integration; in STUB mode the code is also printed to the auth-service log) | log (old mock)
OTP_SENDER=msg91

# --- PII encryption at rest (base64, 32 bytes each: openssl rand -base64 32)
PAYVERSE_CRYPTO_KEY_ID=v1
PAYVERSE_CRYPTO_ENCRYPTION_KEY=
PAYVERSE_CRYPTO_BLIND_INDEX_KEY=

# --- Observability (grafana/otel-lgtm)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TRACING_SAMPLING_PROBABILITY=1.0
LOG_FORMAT=logstash

# --- External providers (docs/EXTERNAL-PROVIDERS.md)
# stub = real request/response code, answered with the provider's default responses (no network, no keys needed)
# live = call the provider; set its base URL and credentials below. Per provider: <NAME>_MODE overrides this,
# <NAME>_ADAPTER=mock brings back the old simulator (e.g. PAYMENT_GATEWAY_ADAPTER=mock, KYC_MODE=live).
PROVIDERS_MODE=stub
# Razorpay (add money)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RazorpayX (withdrawals)
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# MSG91 (OTP + SMS notifications; DLT template ids)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_LOGIN=
MSG91_TEMPLATE_PIN_RESET=
MSG91_TEMPLATE_NOTIFICATION=
# Setu (KYC verification)
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
# Amazon S3 (KYC documents, SSE-KMS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# BBPS biller aggregator
BBPS_API_KEY=
BBPS_AGENT_ID=
# Sponsor/PSP bank UPI API
UPI_PSP_MERCHANT_ID=
UPI_PSP_API_KEY=
# SendGrid (e-mail) and Firebase Cloud Messaging (push)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
