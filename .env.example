# Copy to .env (make env does this and generates random secrets). Never commit .env.

# --- PostgreSQL (one container, one database + role per service)
POSTGRES_USER=payverse
POSTGRES_PASSWORD=change-me
SERVICE_DB_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Security
JWT_ISSUER=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PII encryption at rest (base64, 32 bytes each: openssl rand -base64 32)
PAYVERSE_CRYPTO_KEY_ID=v1
PAYVERSE_CRYPTO_ENCRYPTION_KEY=
PAYVERSE_CRYPTO_BLIND_INDEX_KEY=

# --- Observability (grafana/otel-lgtm)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TRACING_SAMPLING_PROBABILITY=1.0
LOG_FORMAT=logstash
